FLASK_APP=wsgi.py

# development | production | testing
FLASK_ENV=development

# Wajib diganti di server. Generate dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-nilai-acak-yang-panjang

# Format: mysql+pymysql://user:password@host/nama_database
DATABASE_URL=mysql+pymysql://root:@localhost/lpg_forecast_db
